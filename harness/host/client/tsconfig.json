{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "resolveJsonModule": true, "jsx": "react-jsx", "strict": true, "skipLibCheck": true, "noEmit": true, "types": ["react", "react-dom"]
  },
  "include": ["*.tsx", "*.ts"]
}
