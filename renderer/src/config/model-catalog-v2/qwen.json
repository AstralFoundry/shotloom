{
  "provider": "qwen",
  "models": [
    {
      "id": "qwen3.7-plus",
      "name": "Qwen 3.7 Plus",
      "provider": "qwen",
      "type": "textGeneration",
      "sortOrder": 10,
      "enabled": true,
      "defaultMode": "text-generation",
      "modes": [
        {
          "id": "text-generation",
          "label": "文本生成",
          "endpoint": {
            "method": "POST",
            "path": "/compatible-mode/v1/chat/completions",
            "scope": "root"
          },
          "inputConstraints": {
            "text": {
              "maxTokens": 1000000
            }
          },
          "agent": {
            "transport": "provider-default",
            "supportsTools": true
          },
          "outputConstraints": {
            "supportsStreaming": true,
            "supportsStructuredOutput": true,
            "maxTokens": 16384
          },
          "capabilities": [
            "reasoning"
          ],
          "params": [
            {
              "key": "maxTokens",
              "label": "最大长度",
              "type": "select",
              "default": 8192,
              "numeric": true,
              "options": [
                4096,
                8192,
                16384
              ]
            }
          ],
          "auth": {
            "type": "bearer"
          },
          "requestTemplate": {
            "model": "{{model}}",
            "messages": "{{messages}}",
            "max_tokens": "{{params.maxTokens}}",
            "tools": "{{tools}}",
            "tool_choice": "{{toolChoice}}"
          },
          "resultTextPath": "choices.0.message.content"
        },
        {
          "id": "semantic-split",
          "label": "语义拆分",
          "endpoint": {
            "method": "POST",
            "path": "/compatible-mode/v1/chat/completions",
            "scope": "root"
          },
          "inputConstraints": {
            "text": {
              "maxTokens": 1000000
            }
          },
          "agent": {
            "transport": "provider-default",
            "supportsTools": true
          },
          "outputConstraints": {
            "supportsStreaming": true,
            "supportsStructuredOutput": true,
            "maxTokens": 16384
          },
          "capabilities": [
            "structured-output"
          ],
          "params": [
            {
              "key": "maxTokens",
              "label": "最大长度",
              "type": "select",
              "default": 8192,
              "numeric": true,
              "options": [
                4096,
                8192,
                16384
              ]
            }
          ],
          "auth": {
            "type": "bearer"
          },
          "requestTemplate": {
            "model": "{{model}}",
            "messages": "{{messages}}",
            "max_tokens": "{{params.maxTokens}}",
            "tools": "{{tools}}",
            "tool_choice": "{{toolChoice}}"
          },
          "resultTextPath": "choices.0.message.content"
        },
        {
          "id": "storyboard-generation",
          "label": "分镜生成",
          "endpoint": {
            "method": "POST",
            "path": "/compatible-mode/v1/chat/completions",
            "scope": "root"
          },
          "inputConstraints": {
            "text": {
              "maxTokens": 1000000
            }
          },
          "agent": {
            "transport": "provider-default",
            "supportsTools": true
          },
          "outputConstraints": {
            "supportsStreaming": true,
            "supportsStructuredOutput": true,
            "maxTokens": 16384
          },
          "capabilities": [
            "structured-output"
          ],
          "params": [
            {
              "key": "maxTokens",
              "label": "最大长度",
              "type": "select",
              "default": 8192,
              "numeric": true,
              "options": [
                4096,
                8192,
                16384
              ]
            }
          ],
          "auth": {
            "type": "bearer"
          },
          "requestTemplate": {
            "model": "{{model}}",
            "messages": "{{messages}}",
            "max_tokens": "{{params.maxTokens}}",
            "tools": "{{tools}}",
            "tool_choice": "{{toolChoice}}"
          },
          "resultTextPath": "choices.0.message.content"
        }
      ]
    },
    {
      "id": "qwen-image-2.0-pro",
      "name": "Qwen Image 2.0 Pro",
      "provider": "qwen",
      "type": "imageGeneration",
      "sortOrder": 4,
      "enabled": true,
      "defaultMode": "text-to-image",
      "modes": [
        {
          "id": "text-to-image",
          "label": "文生图",
          "endpoint": {
            "method": "POST",
            "path": "/api/v1/services/aigc/multimodal-generation/generation",
            "scope": "root"
          },
          "inputConstraints": {
            "images": {
              "min": 0,
              "max": 0
            }
          },
          "outputConstraints": {
            "maxCount": 6,
            "formats": [
              "png",
              "jpg"
            ]
          },
          "params": [
            {
              "key": "prompt",
              "label": "提示词",
              "type": "text",
              "required": true
            },
            {
              "key": "size",
              "label": "尺寸",
              "type": "select",
              "default": "2048*2048",
              "options": [
                "2048*2048",
                "2304*1728",
                "1728*2304"
              ],
              "optionLabels": {
                "2048*2048": "1:1",
                "2304*1728": "4:3",
                "1728*2304": "3:4"
              }
            },
            {
              "key": "generationCount",
              "label": "张数",
              "type": "select",
              "default": 1,
              "numeric": true,
              "options": [
                1,
                2,
                4,
                6
              ]
            }
          ],
          "auth": {
            "type": "bearer"
          },
          "requestTemplate": {
            "model": "{{model}}",
            "input": {
              "messages": [
                {
                  "role": "user",
                  "content": [
                    {
                      "text": "{{prompt}}"
                    }
                  ]
                }
              ]
            },
            "parameters": {
              "size": "{{params.size}}",
              "n": "{{params.generationCount}}",
              "prompt_extend": true,
              "watermark": false
            }
          },
          "resultUrlPath": "output.choices.*.message.content.*.image"
        }
      ]
    }
  ]
}
