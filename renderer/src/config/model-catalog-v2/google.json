          ],
          "params": [
            {
              "key": "maxTokens",
              "label": "最大长度",
              "type": "select",
              "default": 8192,
              "numeric": true,
              "options": [
                4096,
                8192,
                16384
              ]
            },
            {
              "key": "reasoningEffort",
              "label": "推理强度",
              "type": "select",
              "default": "medium",
              "options": [
                "minimal",
                "low",
                "medium",
                "high"
              ],
              "optionLabels": {
                "minimal": "极简",
                "low": "低",
                "medium": "中",
                "high": "高"
              }
            }
          ],
          "auth": {
            "type": "bearer"
          },
          "requestTemplate": {
            "model": "{{model}}",
            "messages": "{{messages}}",
            "max_tokens": "{{params.maxTokens}}",
            "tools": "{{tools}}",
