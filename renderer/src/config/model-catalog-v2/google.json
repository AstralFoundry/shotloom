              "key": "imageSize",
              "label": "清晰度",
              "type": "select",
              "default": "1K",
              "options": [
                "512",
                "1K",
                "2K",
                "4K"
              ]
            },
            {
              "key": "thinkingLevel",
              "label": "推理强度",
              "type": "select",
              "default": "minimal",
              "options": [
                "minimal",
                "high"
              ],
              "optionLabels": {
                "minimal": "极简",
                "high": "高"
              }
