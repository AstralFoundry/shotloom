    {
      "id": "veo-3.1-generate-preview",
      "name": "Veo 3.1 Preview",
      "provider": "google",
      "type": "videoGeneration",
      "sortOrder": 2,
      "enabled": true,
      "defaultMode": "text-or-image-to-video",
      "modes": [
        {
          "id": "text-or-image-to-video",
          "label": "文生/图生视频",
          "inputMode": "firstFrame",
          "inputSlots": [
            "firstFrame"
          ],
          "endpoint": {
            "method": "POST",
            "path": "/models/veo-3.1-generate-preview:predictLongRunning",
            "scope": "root"
          },
          "taskEndpoint": {
            "method": "GET",
            "path": "/{taskId}",
            "scope": "root"
          },
          "isAsync": true,
          "inputConstraints": {
            "images": {
              "min": 0,
              "max": 1,
              "roles": [
                "referenceImage"
              ]
            }
          },
          "outputConstraints": {
            "durations": [
              4,
              6,
              8
            ],
            "defaultDuration": 8,
            "formats": [
              "mp4"
            ]
          },
          "params": [
            {
              "key": "prompt",
              "label": "提示词",
              "type": "text",
              "required": true
            },
            {
              "key": "duration",
              "label": "时长",
              "type": "select",
              "default": 8,
              "numeric": true,
              "options": [
                4,
                6,
                8
              ]
            },
            {
              "key": "aspectRatio",
              "label": "比例",
              "type": "select",
              "default": "16:9",
              "options": [
                "16:9",
                "9:16"
              ]
            }
          ],
          "auth": {
            "type": "header",
            "name": "x-goog-api-key"
          },
          "requestFields": {
            "imageContentFormat": "google-inline"
          },
          "requestTemplate": {
            "instances": [
              {
                "prompt": "{{prompt}}",
                "image": "{{inlineImage}}"
              }
            ],
            "parameters": {
              "durationSeconds": "{{duration}}",
              "aspectRatio": "{{aspectRatio}}"
            }
          },
          "taskIdPath": "name",
          "statusPath": "done",
          "errorPath": "error.message",
          "pollStatusMap": {
            "false": "running",
            "true": "completed"
          },
          "resultUrlPath": "response.generateVideoResponse.generatedSamples.0.video.uri",
          "resultDownloadAuth": true
        }
      ]
    },
