    {
      "id": "gemini-3.1-flash-image",
      "name": "Gemini 3.1 Flash Image",
      "provider": "google",
      "type": "imageGeneration",
      "sortOrder": 2,
      "enabled": true,
      "defaultMode": "text-to-image",
      "modes": [
        {
          "id": "text-to-image",
          "label": "文生图",
          "endpoint": {
            "method": "POST",
            "path": "/models/gemini-3.1-flash-image:generateContent",
            "scope": "root"
          },
          "inputConstraints": {
            "images": {
              "min": 0,
              "max": 0
            }
          },
          "outputConstraints": {
            "maxCount": 1,
            "formats": [
              "png"
            ]
          },
          "params": [
            {
              "key": "prompt",
              "label": "提示词",
              "type": "text",
              "required": true
            },
            {
              "key": "aspectRatio",
              "label": "比例",
              "type": "select",
              "default": "1:1",
              "options": [
                "1:1",
                "3:2",
                "2:3",
                "4:3",
                "3:4",
                "4:5",
                "5:4",
                "16:9",
                "9:16",
                "21:9"
              ]
            },
            {
              "key": "imageSize",
              "label": "清晰度",
              "type": "select",
              "default": "1K",
              "options": [
                "512",
                "1K",
                "2K",
                "4K"
              ]
            },
            {
              "key": "thinkingLevel",
              "label": "推理强度",
              "type": "select",
              "default": "minimal",
              "options": [
                "minimal",
                "high"
              ],
              "optionLabels": {
                "minimal": "极简",
                "high": "高"
              }
            }
          ],
          "auth": {
            "type": "header",
            "name": "x-goog-api-key"
          },
          "requestTemplate": {
            "contents": [
              {
                "parts": [
                  {
                    "text": "{{prompt}}"
                  }
                ]
              }
            ],
            "generationConfig": {
              "responseModalities": [
                "TEXT",
                "IMAGE"
              ],
              "responseFormat": {
                "image": {
                  "aspectRatio": "{{params.aspectRatio}}",
                  "imageSize": "{{params.imageSize}}"
                }
              },
              "thinkingConfig": {
                "thinkingLevel": "{{params.thinkingLevel}}"
              }
            }
          },
          "resultBase64Path": "candidates.0.content.parts.*.inlineData.data"
        },
        {
          "id": "image-to-image",
          "label": "图片编辑",
          "endpoint": {
            "method": "POST",
            "path": "/models/gemini-3.1-flash-image:generateContent",
