{
  "provider": "xai",
  "models": [
    {
      "id": "grok-4.5",
      "name": "Grok 4.5",
      "provider": "xai",
      "type": "textGeneration",
      "sortOrder": 5,
      "enabled": true,
      "defaultMode": "text-generation",
      "modes": [
        {
          "id": "text-generation",
          "label": "文本生成",
          "endpoint": {
            "method": "POST",
            "path": "/chat/completions",
            "scope": "root"
          },
          "inputConstraints": {
            "text": {
              "maxTokens": 256000
            }
          },
          "agent": {
            "transport": "provider-default",
            "supportsTools": true
          },
          "outputConstraints": {
            "supportsStreaming": true,
            "supportsStructuredOutput": true,
            "maxTokens": 16384
          },
          "capabilities": [
            "reasoning"
          ],
          "params": [
            {
              "key": "maxTokens",
              "label": "最大长度",
              "type": "select",
              "default": 8192,
              "numeric": true,
              "options": [
                4096,
                8192,
                16384
              ]
            }
          ],
          "auth": {
            "type": "bearer"
          },
          "requestTemplate": {
            "model": "{{model}}",
            "messages": "{{messages}}",
            "max_tokens": "{{params.maxTokens}}",
            "tools": "{{tools}}",
            "tool_choice": "{{toolChoice}}"
          },
          "resultTextPath": "choices.0.message.content"
        },
        {
          "id": "semantic-split",
          "label": "语义拆分",
          "endpoint": {
            "method": "POST",
            "path": "/chat/completions",
            "scope": "root"
          },
          "inputConstraints": {
            "text": {
              "maxTokens": 256000
            }
          },
          "agent": {
            "transport": "provider-default",
            "supportsTools": true
          },
          "outputConstraints": {
            "supportsStreaming": true,
            "supportsStructuredOutput": true,
            "maxTokens": 16384
          },
          "capabilities": [
            "structured-output"
          ],
          "params": [
            {
              "key": "maxTokens",
              "label": "最大长度",
              "type": "select",
              "default": 8192,
              "numeric": true,
              "options": [
                4096,
                8192,
                16384
              ]
            }
          ],
          "auth": {
            "type": "bearer"
          },
          "requestTemplate": {
            "model": "{{model}}",
            "messages": "{{messages}}",
            "max_tokens": "{{params.maxTokens}}",
            "tools": "{{tools}}",
            "tool_choice": "{{toolChoice}}"
          },
          "resultTextPath": "choices.0.message.content"
        },
        {
          "id": "storyboard-generation",
          "label": "分镜生成",
          "endpoint": {
            "method": "POST",
            "path": "/chat/completions",
            "scope": "root"
          },
          "inputConstraints": {
            "text": {
              "maxTokens": 256000
            }
          },
          "agent": {
            "transport": "provider-default",
            "supportsTools": true
          },
          "outputConstraints": {
            "supportsStreaming": true,
            "supportsStructuredOutput": true,
            "maxTokens": 16384
          },
          "capabilities": [
            "structured-output"
          ],
          "params": [
            {
              "key": "maxTokens",
              "label": "最大长度",
              "type": "select",
              "default": 8192,
              "numeric": true,
              "options": [
                4096,
                8192,
                16384
              ]
            }
          ],
          "auth": {
            "type": "bearer"
          },
          "requestTemplate": {
            "model": "{{model}}",
            "messages": "{{messages}}",
            "max_tokens": "{{params.maxTokens}}",
            "tools": "{{tools}}",
            "tool_choice": "{{toolChoice}}"
          },
          "resultTextPath": "choices.0.message.content"
        }
      ]
    },
    {
      "id": "grok-imagine-image-quality",
      "name": "Grok Imagine Image Quality",
      "provider": "xai",
      "type": "imageGeneration",
      "sortOrder": 3,
      "enabled": true,
      "defaultMode": "text-to-image",
      "modes": [
        {
          "id": "text-to-image",
          "label": "文生图",
          "endpoint": {
            "method": "POST",
            "path": "/images/generations",
            "scope": "root"
          },
          "inputConstraints": {
            "images": {
              "min": 0,
              "max": 0
            }
          },
          "outputConstraints": {
            "maxCount": 4,
            "formats": [
              "png",
              "jpg"
            ]
          },
          "params": [
            {
              "key": "prompt",
              "label": "提示词",
              "type": "text",
              "required": true
            },
            {
              "key": "aspectRatio",
              "label": "比例",
              "type": "select",
              "default": "1:1",
              "options": [
                "1:1",
                "16:9",
                "9:16",
                "4:3",
                "3:4"
              ]
            },
            {
              "key": "generationCount",
              "label": "张数",
              "type": "select",
              "default": 1,
              "numeric": true,
              "options": [
                1,
                2,
                4
              ]
            }
          ],
          "auth": {
            "type": "bearer"
          },
          "requestTemplate": {
            "model": "{{model}}",
            "prompt": "{{prompt}}",
            "aspect_ratio": "{{params.aspectRatio}}",
            "n": "{{params.generationCount}}"
          },
          "resultUrlPath": "data.*.url",
          "resultBase64Path": "data.*.b64_json"
        }
      ]
    },
    {
      "id": "grok-imagine-video",
      "name": "Grok Imagine Video",
      "provider": "xai",
      "type": "videoGeneration",
      "sortOrder": 1,
      "enabled": true,
      "defaultMode": "text-or-image-to-video",
      "modes": [
        {
          "id": "text-or-image-to-video",
          "label": "文生/图生视频",
          "inputMode": "firstFrame",
          "inputSlots": [
            "firstFrame"
          ],
          "endpoint": {
            "method": "POST",
            "path": "/videos/generations",
            "scope": "root"
          },
          "taskEndpoint": {
            "method": "GET",
            "path": "/videos/{taskId}",
            "scope": "root"
          },
          "isAsync": true,
          "inputConstraints": {
            "images": {
              "min": 0,
              "max": 1,
              "roles": [
                "referenceImage"
              ]
            }
          },
          "outputConstraints": {
            "durations": [
              5,
              8,
              10,
              15
            ],
            "defaultDuration": 8,
            "formats": [
              "mp4"
            ]
          },
          "params": [
            {
              "key": "prompt",
              "label": "提示词",
              "type": "text",
              "required": true
            },
            {
              "key": "duration",
              "label": "时长",
              "type": "select",
              "default": 8,
              "numeric": true,
              "options": [
                5,
                8,
                10,
                15
              ]
            },
            {
              "key": "aspectRatio",
              "label": "比例",
              "type": "select",
              "default": "16:9",
              "options": [
                "16:9",
                "9:16",
                "1:1"
              ]
            },
            {
              "key": "resolution",
              "label": "分辨率",
              "type": "select",
              "default": "720p",
              "options": [
                "480p",
                "720p"
              ]
            }
          ],
          "auth": {
            "type": "bearer"
          },
          "requestTemplate": {
            "model": "{{model}}",
            "prompt": "{{prompt}}",
            "image": "{{imageObject}}",
            "duration": "{{duration}}",
            "aspect_ratio": "{{aspectRatio}}",
            "resolution": "{{resolution}}"
          },
          "taskIdPath": "request_id",
          "statusPath": "status",
          "errorPath": "error.message",
          "pollStatusMap": {
            "pending": "running",
            "done": "completed",
            "expired": "failed",
            "failed": "failed"
          },
          "resultUrlPath": "video.url"
        }
      ]
    },
    {
      "id": "grok-imagine-video-1.5",
      "name": "Grok Imagine Video 1.5",
      "provider": "xai",
      "type": "videoGeneration",
      "sortOrder": 2,
      "enabled": true,
      "defaultMode": "image-to-video",
      "modes": [
        {
          "id": "image-to-video",
          "label": "图生视频",
          "inputMode": "firstFrame",
          "inputSlots": [
            "firstFrame"
          ],
          "endpoint": {
            "method": "POST",
            "path": "/videos/generations",
            "scope": "root"
          },
          "taskEndpoint": {
            "method": "GET",
            "path": "/videos/{taskId}",
            "scope": "root"
          },
          "isAsync": true,
          "inputConstraints": {
            "images": {
              "min": 1,
              "max": 1,
              "roles": [
                "referenceImage"
              ]
            }
          },
          "outputConstraints": {
            "durations": [
              5,
              8,
              10,
              12,
              15
            ],
            "defaultDuration": 8,
            "formats": [
              "mp4"
            ]
          },
          "params": [
            {
              "key": "prompt",
              "label": "提示词",
              "type": "text",
              "required": true
            },
            {
              "key": "duration",
              "label": "时长",
              "type": "select",
              "default": 8,
              "numeric": true,
              "options": [
                5,
                8,
                10,
                12,
                15
              ]
            },
            {
              "key": "resolution",
              "label": "分辨率",
              "type": "select",
              "default": "720p",
              "options": [
                "480p",
                "720p",
                "1080p"
              ]
            }
          ],
          "auth": {
            "type": "bearer"
          },
          "requestTemplate": {
            "model": "{{model}}",
            "prompt": "{{prompt}}",
            "image": {
              "url": "{{imageUrl}}"
            },
            "duration": "{{duration}}",
            "resolution": "{{resolution}}"
          },
          "taskIdPath": "request_id",
          "statusPath": "status",
          "errorPath": "error.message",
          "pollStatusMap": {
            "pending": "running",
            "done": "completed",
            "expired": "failed",
            "failed": "failed"
          },
          "resultUrlPath": "video.url"
        }
      ]
    }
  ]
}
