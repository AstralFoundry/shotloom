            "model": "{{model}}",
            "prompt": "{{prompt}}",
            "size": "{{params.size}}",
            "n": "{{params.generationCount}}"
          },
          "resultBase64Path": "data.*.b64_json",
          "resultUrlPath": "data.*.url"
        }
      ]
