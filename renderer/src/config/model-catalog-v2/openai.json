        {
          "id": "text-generation",
          "label": "文本生成",
          "endpoint": {
            "method": "POST",
            "path": "/chat/completions",
            "scope": "root"
          },
          "inputConstraints": {
            "text": {
              "maxTokens": 1000000
            }
          },
          "agent": {
            "transport": "openai-responses",
