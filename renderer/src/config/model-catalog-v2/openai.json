              "optionLabels": {
                "none": "关闭",
                "low": "低",
                "medium": "中",
                "high": "高",
                "xhigh": "极高",
                "max": "最高"
              }
            }
          ],
          "auth": {
            "type": "bearer"
          },
          "requestTemplate": {
