{
  "provider": "openai",
  "models": [
    {
      "id": "gpt-5.6",
      "name": "GPT 5.6",
      "provider": "openai",
      "type": "textGeneration",
      "sortOrder": 1,
      "enabled": true,
      "defaultMode": "text-generation",
      "modes": [
        {
          "id": "text-generation",
          "label": "文本生成",
          "endpoint": {
            "method": "POST",
            "path": "/chat/completions",
            "scope": "root"
          },
          "inputConstraints": {
            "text": {
              "maxTokens": 1000000
            }
          },
          "agent": {
            "transport": "openai-responses",
            "supportsTools": true,
            "endpoint": {
              "method": "POST",
              "path": "/responses",
              "scope": "root"
            }
          },
          "outputConstraints": {
            "supportsStreaming": true,
            "supportsStructuredOutput": true,
            "maxTokens": 16384
          },
          "capabilities": [
            "reasoning"
          ],
          "params": [
            {
              "key": "maxTokens",
              "label": "最大长度",
              "type": "select",
              "default": 8192,
              "numeric": true,
              "options": [
                4096,
                8192,
                16384
              ]
            }
          ],
          "auth": {
            "type": "bearer"
          },
          "requestTemplate": {
            "model": "{{model}}",
            "messages": "{{messages}}",
            "max_completion_tokens": "{{params.maxTokens}}",
            "reasoning_effort": "{{reasoningEffort}}",
            "tools": "{{tools}}",
            "tool_choice": "{{toolChoice}}"
          },
          "resultTextPath": "choices.0.message.content"
        },
        {
          "id": "semantic-split",
