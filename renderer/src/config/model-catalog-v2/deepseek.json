{
  "provider": "deepseek",
  "models": [
    {
      "id": "deepseek-v4-pro",
      "name": "DeepSeek V4 Pro",
      "provider": "deepseek",
      "type": "textGeneration",
      "sortOrder": 8,
      "enabled": true,
      "defaultMode": "text-generation",
      "modes": [
        {
          "id": "text-generation",
          "label": "文本生成",
          "endpoint": {
            "method": "POST",
            "path": "/chat/completions",
            "scope": "root"
          },
          "inputConstraints": {
            "text": {
              "maxTokens": 1000000
            }
          },
          "agent": {
            "transport": "provider-default",
            "supportsTools": true
          },
          "outputConstraints": {
            "supportsStreaming": true,
            "supportsStructuredOutput": true,
            "maxTokens": 16384
          },
          "capabilities": [
            "reasoning"
          ],
          "params": [
            {
              "key": "maxTokens",
              "label": "最大长度",
              "type": "select",
              "default": 8192,
              "numeric": true,
              "options": [
                4096,
                8192,
                16384
              ],
              "labelKey": "catalog.label.c6f7a87b1e"
            }
          ],
          "auth": {
            "type": "bearer"
          },
          "requestTemplate": {
            "model": "{{model}}",
            "messages": "{{messages}}",
            "max_tokens": "{{params.maxTokens}}",
            "tools": "{{tools}}",
            "tool_choice": "{{toolChoice}}"
          },
          "resultTextPath": "choices.0.message.content",
