# 运行环境
NODE_ENV=development
PORT=3001

# new-api OIDC 网关（身份源）
GATEWAY_BASE_URL=https://newapi.0xfiang.com
GATEWAY_CLIENT_ID=your-confidential-client-id
GATEWAY_CLIENT_SECRET=your-confidential-client-secret
GATEWAY_REDIRECT_URI=http://localhost:5173/api/auth/callback

# Supabase（dnxsksdoipdctstpqtsa）
SUPABASE_URL=https://dnxsksdoipdctstpqtsa.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_AUTH_PROVIDER=custom:shotloom-newapi

# 会话 token 加密密钥（64 位 hex = 32 字节）
SESSION_ENCRYPTION_KEY=generate-32-random-bytes-as-64-hex-characters

# 登录成功后前端回调地址
FRONTEND_URL=http://localhost:5173

# 会话 Cookie 名称
COOKIE_NAME=shotloom_session
