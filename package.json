{
  "name": "shotloom",
  "productName": "Shotloom",
  "version": "0.1.2",
  "private": true,
  "description": "Tauri-powered workflow panel for AI comic production with a light asset-management UI.",
  "scripts": {
    "prepare:opencode": "node scripts/prepare-opencode-sidecar.mjs",
    "predev": "npm run prepare:opencode",
    "predev:web": "npm run prepare:opencode",
    "prebuild": "npm run prepare:opencode",
    "prebuild:desktop": "npm run prepare:opencode",
    "pretauri": "npm run prepare:opencode",
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:desktop": "tauri build",
    "tauri": "tauri",
    "check": "npm run typecheck && npm test",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@lobehub/icons-static-svg": "1.94.0",
    "@opencode-ai/sdk": "1.18.4",
    "@openvideo/core": "1.3.2",
    "@openvideo/engine-pixi": "1.3.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xyflow/react": "12.9.3",
    "lucide-react": "^1.27.0",
    "opencode-ai": "1.18.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "three": "^0.185.1",
    "three-stdlib": "^2.36.1",
    "zustand": "5.0.11"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=10.0.0"
  }
}
