# Cloud is the default. Serve Web and the BFF from one origin.
VITE_STORAGE_MODE=cloud
# Leave empty when Vite proxies /api or the production BFF serves the built UI.
VITE_SERVER_URL=
# Native cloud builds load this exact HTTPS origin and grant it desktop capabilities.
SHOTLOOM_CLOUD_URL=https://shotloom.0xfiang.com
