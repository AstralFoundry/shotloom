{
  "name": "shotloom-native",
  "version": "0.9.11",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "audit:build": "node ../../scripts/audit-native-build.mjs",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "bundle:check": "expo export --platform all --output-dir dist"
  },
  "dependencies": {
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "expo": "57.0.33",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.21",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-localization": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/node": "22.13.0",
    "@types/react": "19.2.14",
    "@types/react-test-renderer": "^19.3.1",
    "esbuild": "^0.28.1",
    "react-test-renderer": "^19.2.3",
    "tsx": "4.22.4",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@expo/fingerprint": {
      "minimatch": "11.0.1"
    }
  }
}
