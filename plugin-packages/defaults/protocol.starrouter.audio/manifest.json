  "protocols": [
    {
      "id": "operation.454da5625213e28a",
      "description": "MiniMax Speech 2.8 HD（StarRouter）",
      "mode": {
        "endpoint": {
          "method": "POST",
          "path": "/audio/speech",
          "scope": "root"
        },
        "auth": {
          "type": "bearer"
        },
        "requestTemplate": {
          "model": "{{model}}",
          "input": "{{prompt}}",
          "voice": "{{params.voice}}",
          "speed": "{{params.speed}}",
          "output_format": "hex"
        },
        "resultBody": {
          "encoding": "binary",
          "mimeType": "audio/mpeg",
          "fileExtension": "mp3"
        },
        "id": "text-to-speech",
        "label": "文字转语音",
        "inputConstraints": {
          "text": {
            "maxTokens": 4096
          }
        },
        "outputConstraints": {
          "maxCount": 1,
          "formats": [
            "mp3"
          ]
        },
        "params": [
          {
            "key": "prompt",
            "label": "朗读文本",
            "type": "text",
            "required": true,
            "labelKey": "catalog.label.a83ab1ba9a"
          },
          {
            "key": "voice",
            "label": "音色",
            "type": "text",
            "required": true,
            "default": "female-shaonv",
            "presentation": {
              "control": "voice",
              "group": "声音",
              "summary": true
            },
            "labelKey": "catalog.label.c4301894a2"
          },
          {
            "key": "speed",
            "label": "语速",
            "type": "select",
            "default": 1,
            "numeric": true,
            "options": [
              0.5,
              0.75,
              1,
              1.25,
              1.5,
              2
            ],
            "labelKey": "catalog.label.747374775d"
          }
        ],
        "labelKey": "catalog.label.c4383c679a"
      }
    }
  ],
