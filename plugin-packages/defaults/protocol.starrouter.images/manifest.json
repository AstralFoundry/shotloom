{
  "apiVersion": 1,
  "kind": "protocol",
  "id": "protocol.starrouter.images",
  "name": "StarRouter Images",
  "version": "1.0.0",
  "shotloom": ">=0.9.1, <1.0.0",
  "category": "imageGeneration",
  "iconId": "starrouter",
  "engine": "declarative",
  "protocols": [
    {
      "id": "operation.14a8e402b25602b5",
      "description": "Gemini 3.1 Flash Image（StarRouter）",
      "mode": {
        "endpoint": {
          "method": "POST",
          "path": "/v1beta/models/{model}:generateContent",
          "scope": "root"
        },
        "auth": {
          "type": "bearer"
        },
        "requestTemplate": {
          "contents": [
            {
              "parts": [
                {
                  "text": "{{prompt}}"
                }
              ]
            }
          ],
          "generationConfig": {
            "responseModalities": [
              "TEXT",
              "IMAGE"
            ],
            "imageConfig": {
              "aspectRatio": "{{params.aspectRatio}}"
            }
          }
        },
        "resultBase64Path": "candidates.0.content.parts.*.inlineData.data",
        "id": "text-to-image",
        "label": "文生图",
        "inputConstraints": {
          "images": {
            "min": 0,
            "max": 0
          }
        },
        "outputConstraints": {
          "maxCount": 1,
          "formats": [
            "png"
          ]
        },
        "params": [
          {
            "key": "prompt",
            "label": "提示词",
            "type": "text",
            "required": true,
            "labelKey": "catalog.label.2f0bb12387"
          },
          {
            "key": "aspectRatio",
            "label": "比例",
            "type": "select",
            "default": "1:1",
            "options": [
              "1:1",
              "16:9",
              "9:16",
              "4:3",
              "3:4"
            ],
            "labelKey": "catalog.label.c27f341ce5"
          }
        ],
        "labelKey": "catalog.label.0b835958b8"
      }
    }
  ],
  "providers": [],
  "author": "Shotloom Contributors",
