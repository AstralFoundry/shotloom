      "engine": "declarative",
      "pluginId": "protocol.starrouter.images",
      "presetId": "protocol",
      "models": [
        {
          "id": "starrouter-gemini-3.1-flash-image",
          "name": "Gemini 3.1 Flash Image（StarRouter）",
          "upstreamModel": "gemini-3.1-flash-image",
          "type": "imageGeneration",
          "sortOrder": 22,
          "enabled": true,
          "defaultMode": "text-to-image",
