  "protocols": [
    {
      "id": "zhipu.text.operation.43848bdb90bb52d7",
      "description": "GLM 5.3",
      "mode": {
        "endpoint": {
          "method": "POST",
          "path": "/paas/v4/chat/completions",
          "scope": "root"
        },
        "agent": {
          "transport": "provider-default",
          "supportsTools": true,
          "compat": {
            "supportsLongCacheRetention": false,
            "supportsStore": false,
            "supportsDeveloperRole": false,
            "maxTokensField": "max_tokens"
          }
        },
        "auth": {
          "type": "bearer"
        },
        "requestTemplate": {
          "model": "{{model}}",
          "messages": "{{messages}}",
          "max_tokens": "{{params.maxTokens}}",
          "tools": "{{tools}}",
          "tool_choice": "{{toolChoice}}"
        },
        "resultTextPath": "choices.0.message.content",
        "id": "text-generation",
        "label": "文本生成",
        "inputConstraints": {
          "text": {
            "maxTokens": 1000000
          }
        },
        "outputConstraints": {
          "supportsStreaming": true,
          "supportsStructuredOutput": true,
          "maxTokens": 16384
        },
        "capabilities": [
          "reasoning"
        ],
        "params": [
          {
            "key": "maxTokens",
            "label": "最大长度",
            "type": "select",
            "default": 8192,
            "numeric": true,
            "options": [
              4096,
              8192,
              16384
            ],
            "labelKey": "catalog.label.c6f7a87b1e"
          }
        ],
        "labelKey": "catalog.label.9612898b53"
      }
    },
    {
      "id": "zhipu.images.operation.c77b66ffedaab9fb",
      "description": "GLM Image",
      "mode": {
        "endpoint": {
          "method": "POST",
          "path": "/paas/v4/images/generations",
          "scope": "root"
        },
        "auth": {
          "type": "bearer"
        },
        "requestTemplate": {
          "model": "{{model}}",
          "prompt": "{{prompt}}",
          "size": "{{params.size}}",
          "quality": "hd"
        },
        "resultUrlPath": "data.*.url",
        "id": "text-to-image",
        "label": "文生图",
        "inputConstraints": {
          "images": {
            "min": 0,
            "max": 0
          }
        },
        "outputConstraints": {
          "maxCount": 1,
          "formats": [
            "png",
            "jpg"
          ]
        },
        "params": [
          {
            "key": "prompt",
            "label": "提示词",
            "type": "text",
            "required": true,
            "labelKey": "catalog.label.2f0bb12387"
          },
          {
            "key": "size",
            "label": "尺寸",
            "type": "select",
            "default": "1280x1280",
            "options": [
              "1280x1280",
              "1568x1056",
              "1056x1568",
              "1728x960",
              "960x1728"
            ],
            "optionLabels": {
              "1280x1280": "1:1",
              "1568x1056": "约 3:2",
              "1056x1568": "约 2:3",
              "1728x960": "约 16:9",
              "960x1728": "约 9:16"
            },
            "labelKey": "catalog.label.94a6711f24",
            "optionLabelKeys": {
              "1568x1056": "catalog.label.bf857688b1",
              "1056x1568": "catalog.label.9d0e1e49c6",
              "1728x960": "catalog.label.4388778a77",
              "960x1728": "catalog.label.29fb3cf809"
            }
          }
        ],
        "labelKey": "catalog.label.0b835958b8"
      }
    },
    {
      "id": "zhipu.video.operation.5f5a2bbf50cd67c3",
      "description": "CogVideoX 3",
      "mode": {
        "endpoint": {
          "method": "POST",
          "path": "/paas/v4/videos/generations",
          "scope": "root"
        },
        "taskEndpoint": {
          "method": "GET",
          "path": "/paas/v4/async-result/{taskId}",
          "scope": "root"
        },
        "isAsync": true,
        "auth": {
          "type": "bearer"
        },
        "requestTemplate": {
          "model": "{{model}}",
          "prompt": "{{prompt}}",
          "image_url": "{{imageUrl}}",
          "quality": "{{params.quality}}"
        },
        "taskIdPath": "id",
        "statusPath": "task_status",
        "errorPath": "error.message",
        "pollStatusMap": {
          "PROCESSING": "running",
          "SUCCESS": "completed",
          "FAIL": "failed"
        },
        "resultUrlPath": "video_result.*.url",
        "id": "text-or-image-to-video",
        "label": "文生/图生视频",
        "inputMode": "firstFrame",
        "inputSlots": [
          "firstFrame"
        ],
        "inputConstraints": {
          "images": {
            "min": 0,
            "max": 1,
            "roles": [
              "referenceImage"
            ]
          }
        },
        "outputConstraints": {
          "formats": [
            "mp4"
          ]
        },
        "params": [
          {
            "key": "prompt",
            "label": "提示词",
            "type": "text",
            "required": true,
            "labelKey": "catalog.label.2f0bb12387"
          },
          {
            "key": "quality",
            "label": "输出模式",
            "type": "select",
            "default": "quality",
            "options": [
              "quality",
              "speed"
            ],
            "labelKey": "catalog.label.973f0cc4ef"
          }
        ],
        "labelKey": "catalog.label.8546cca0b1"
      }
    }
