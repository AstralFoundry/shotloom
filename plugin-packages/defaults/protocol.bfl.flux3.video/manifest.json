          "mode": "i2v",
          "prompt": "{{prompt}}",
          "duration": "{{params.duration}}",
          "aspect_ratio": "{{params.aspectRatio}}",
          "resolution": "{{params.resolution}}",
          "generate_audio": true,
          "keyframes": "{{imageUrl}}"
        },
        "isAsync": true,
        "taskIdPath": "id",
