{
  "apiVersion": 1,
  "kind": "protocol",
  "id": "protocol.minimax.text",
  "name": "MiniMax Text",
  "version": "1.0.0",
  "shotloom": ">=0.9.1, <1.0.0",
  "category": "textGeneration",
  "iconId": "minimax",
  "engine": "declarative",
  "homepage": "https://platform.minimax.io/docs/api-reference/text-openai-api",
  "protocols": [
    {
      "id": "chat",
      "mode": {
        "endpoint": {
          "path": "/v1/chat/completions",
          "method": "POST",
          "scope": "root"
        },
        "agent": {
          "transport": "provider-default",
          "supportsTools": true,
          "endpoint": {
            "path": "/v1/chat/completions",
            "method": "POST",
            "scope": "root"
          }
        },
        "auth": {
          "type": "bearer"
        },
        "requestTemplate": {
          "model": "{{model}}",
          "messages": "{{messages}}",
          "max_tokens": "{{params.maxTokens}}",
          "tools": "{{tools}}",
          "tool_choice": "{{toolChoice}}",
          "reasoning_effort": "{{params.reasoningEffort}}"
        },
        "resultTextPath": "choices.0.message.content",
        "requestFields": {
          "imageContentFormat": "openai-image-url"
        },
        "id": "text-generation",
        "label": "文本生成",
        "inputConstraints": {
          "text": {
            "maxTokens": 1000000
          }
        },
        "outputConstraints": {
          "maxTokens": 16384,
          "supportsStreaming": true
        },
        "capabilities": [
          "reasoning"
        ],
        "params": [
          {
            "key": "maxTokens",
            "label": "最大长度",
            "type": "select",
            "default": 8192,
            "numeric": true,
            "options": [
              4096,
              8192,
              16384
            ],
            "labelKey": "catalog.label.c6f7a87b1e"
          },
          {
            "key": "reasoningEffort",
            "label": "推理强度",
            "labelKey": "catalog.label.66778fdee4",
            "type": "select",
            "options": [
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ],
            "default": "max",
            "numeric": false
          }
        ],
        "labelKey": "catalog.label.9612898b53"
      }
    }
  ],
