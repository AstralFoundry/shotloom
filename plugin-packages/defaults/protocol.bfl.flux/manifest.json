{
  "apiVersion": 1,
  "kind": "protocol",
  "id": "protocol.bfl.flux",
  "name": "Black Forest Labs FLUX",
  "version": "1.0.0",
  "shotloom": ">=0.9.1, <1.0.0",
  "category": "imageGeneration",
  "iconId": "bfl",
  "engine": "declarative",
  "homepage": "https://docs.bfl.ai/quick_start/generating_images",
  "protocols": [
    {
      "id": "generate",
      "mode": {
        "id": "text-to-image",
        "label": "文生图",
        "endpoint": {
          "path": "/v1/{model}",
          "method": "POST",
          "scope": "root"
        },
        "auth": {
          "type": "header",
          "name": "x-key",
          "prefix": ""
        },
        "inputConstraints": {},
        "outputConstraints": {},
        "params": [
          {
            "key": "width",
            "label": "宽度",
            "labelKey": "plugins.parameter.width",
            "type": "select",
            "options": [
              768,
              1024,
              1440,
              2048
            ],
            "default": 1024,
            "numeric": true
          },
          {
            "key": "height",
            "label": "高度",
            "labelKey": "plugins.parameter.height",
            "type": "select",
            "options": [
              768,
              1024,
              1440,
              2048
            ],
            "default": 1024,
            "numeric": true
          }
        ],
        "requestTemplate": {
          "prompt": "{{prompt}}",
          "width": "{{params.width}}",
          "height": "{{params.height}}",
          "output_format": "jpeg"
        },
        "isAsync": true,
        "taskIdPath": "id",
        "statusPath": "status",
        "resultUrlPath": "result.sample",
        "taskEndpoint": {
          "path": "/v1/get_result?id={taskId}",
          "method": "GET",
          "scope": "root"
        },
        "pollStatusMap": {
          "Pending": "queued",
          "Reasoning": "running",
          "Generating": "running",
          "Ready": "completed",
          "Error": "failed",
          "Task not found": "failed",
          "Request Moderated": "failed",
          "Content Moderated": "failed",
          "No Card Generated": "failed"
        },
        "errorPath": "details",
        "labelKey": "catalog.label.0b835958b8"
      }
    },
    {
      "id": "edit",
      "mode": {
        "id": "image-to-image",
        "label": "图片编辑",
        "endpoint": {
          "path": "/v1/{model}",
          "method": "POST",
          "scope": "root"
        },
        "auth": {
          "type": "header",
          "name": "x-key",
          "prefix": ""
        },
        "inputConstraints": {
          "images": {
            "min": 1,
            "max": 1,
            "roles": [
              "referenceImage"
            ]
          }
        },
        "outputConstraints": {},
        "params": [
          {
            "key": "width",
            "label": "宽度",
            "labelKey": "plugins.parameter.width",
            "type": "select",
            "options": [
              768,
              1024,
              1440,
              2048
            ],
            "default": 1024,
            "numeric": true
          },
          {
            "key": "height",
            "label": "高度",
            "labelKey": "plugins.parameter.height",
            "type": "select",
            "options": [
              768,
              1024,
              1440,
              2048
            ],
            "default": 1024,
            "numeric": true
          }
        ],
        "requestTemplate": {
          "prompt": "{{prompt}}",
          "width": "{{params.width}}",
          "height": "{{params.height}}",
          "output_format": "jpeg",
          "input_image": "{{imageUrl}}"
        },
        "isAsync": true,
        "taskIdPath": "id",
        "statusPath": "status",
        "resultUrlPath": "result.sample",
        "taskEndpoint": {
          "path": "/v1/get_result?id={taskId}",
          "method": "GET",
          "scope": "root"
        },
        "pollStatusMap": {
          "Pending": "queued",
          "Reasoning": "running",
          "Generating": "running",
          "Ready": "completed",
          "Error": "failed",
          "Task not found": "failed",
          "Request Moderated": "failed",
          "Content Moderated": "failed",
          "No Card Generated": "failed"
        },
        "errorPath": "details",
        "labelKey": "catalog.label.a038dfa6cd",
        "inputMode": "reference",
        "inputSlots": [
          "reference"
        ]
      }
    }
  ],
  "providers": [],
  "author": "Shotloom Contributors",
  "defaultConnections": [
    {
      "id": "bfl",
      "name": "Black Forest Labs",
      "baseUrl": "https://api.bfl.ai",
      "iconId": "bfl",
      "description": "FLUX image generation and editing",
      "descriptionKey": "plugins.provider.bfl",
      "enabled": true,
      "builtin": true,
      "presetId": "protocol",
      "pluginId": "protocol.bfl.flux",
      "models": [
        {
          "id": "flux-2-pro",
          "name": "FLUX.2 Pro",
          "upstreamModel": "flux-2-pro",
          "type": "imageGeneration",
          "sortOrder": 100,
          "enabled": true,
          "defaultMode": "text-to-image",
          "protocolPlugin": "protocol.bfl.flux",
          "protocolModes": {
            "text-to-image": "generate",
            "image-to-image": "edit"
          },
          "modes": [
            {
              "id": "text-to-image",
              "label": "文生图",
              "inputConstraints": {},
              "outputConstraints": {},
              "params": [
                {
                  "key": "width",
                  "label": "宽度",
                  "labelKey": "plugins.parameter.width",
                  "type": "select",
                  "options": [
                    768,
                    1024,
                    1440,
                    2048
                  ],
                  "default": 1024,
                  "numeric": true
                },
                {
                  "key": "height",
                  "label": "高度",
                  "labelKey": "plugins.parameter.height",
                  "type": "select",
                  "options": [
                    768,
                    1024,
                    1440,
                    2048
                  ],
                  "default": 1024,
                  "numeric": true
                }
              ],
              "labelKey": "catalog.label.0b835958b8"
            },
            {
              "id": "image-to-image",
              "label": "图片编辑",
              "inputConstraints": {
                "images": {
                  "min": 1,
                  "max": 1,
                  "roles": [
                    "referenceImage"
                  ]
                }
              },
              "outputConstraints": {},
              "params": [
                {
                  "key": "width",
                  "label": "宽度",
                  "labelKey": "plugins.parameter.width",
                  "type": "select",
                  "options": [
                    768,
                    1024,
                    1440,
                    2048
                  ],
                  "default": 1024,
                  "numeric": true
                },
                {
                  "key": "height",
                  "label": "高度",
                  "labelKey": "plugins.parameter.height",
                  "type": "select",
                  "options": [
                    768,
                    1024,
                    1440,
                    2048
                  ],
                  "default": 1024,
                  "numeric": true
                }
              ],
              "labelKey": "catalog.label.a038dfa6cd",
              "inputMode": "reference",
              "inputSlots": [
                "reference"
              ]
            }
          ]
        }
      ],
      "preserveModelIds": true,
      "sortOrder": 13
    }
  ]
}
