{
  "apiVersion": 2,
  "kind": "vendor",
  "id": "vendor.runway",
  "name": "Runway",
  "version": "1.0.1",
  "shotloom": ">=0.9.2, <1.0.0",
  "iconId": "runway",
  "description": "Runway 厂商插件，统一提供模型和画布工具，共用连接与 API Key。",
  "engine": "declarative",
  "protocols": [
    {
      "id": "runway.video.generate",
      "mode": {
        "id": "text-to-video",
        "label": "文生视频",
        "endpoint": {
          "path": "/v1/text_to_video",
          "method": "POST",
          "scope": "root"
        },
        "auth": {
          "type": "bearer"
        },
        "inputConstraints": {},
        "outputConstraints": {
          "durations": [
            2,
            3,
            4,
            5,
            6,
            7,
            8,
            9,
            10
          ],
          "defaultDuration": 5
        },
        "params": [
          {
            "key": "aspectRatio",
            "label": "画面比例",
            "labelKey": "plugins.parameter.aspectRatio",
            "type": "select",
            "options": [
              "16:9",
              "9:16"
            ],
            "default": "16:9",
            "numeric": false
          },
          {
            "key": "duration",
            "label": "时长",
            "labelKey": "plugins.parameter.duration",
            "type": "select",
            "options": [
              2,
              3,
              4,
              5,
              6,
              7,
              8,
              9,
              10
            ],
            "default": 5,
            "numeric": true
          }
        ],
        "requestTemplate": {
          "model": "{{model}}",
          "promptText": "{{prompt}}",
          "ratio": "{{params.aspectRatio}}",
          "duration": "{{params.duration}}"
        },
        "isAsync": true,
        "taskIdPath": "id",
        "statusPath": "status",
        "resultUrlPath": "output.*",
        "taskEndpoint": {
          "path": "/v1/tasks/{taskId}",
          "method": "GET",
          "scope": "root"
        },
        "pollStatusMap": {
          "PENDING": "queued",
          "THROTTLED": "queued",
          "RUNNING": "running",
          "SUCCEEDED": "completed",
          "FAILED": "failed",
          "CANCELLED": "cancelled"
        },
        "progressPath": "progress",
        "progressScale": 100,
        "errorPath": "failure",
        "headers": {
          "X-Runway-Version": "2024-11-06"
        },
        "cancelEndpoint": {
          "path": "/v1/tasks/{taskId}",
          "method": "DELETE",
          "scope": "root"
        },
        "labelKey": "catalog.label.dd6f194c41",
        "requestValueMaps": {
          "aspectRatio": {
            "16:9": "1280:720",
            "9:16": "720:1280"
          }
        }
      }
    },
    {
      "id": "runway.video.animate",
      "mode": {
        "id": "image-to-video",
        "label": "图生视频",
        "endpoint": {
          "path": "/v1/image_to_video",
          "method": "POST",
          "scope": "root"
        },
        "auth": {
          "type": "bearer"
        },
        "inputConstraints": {
          "images": {
            "min": 1,
            "max": 1,
            "roles": [
              "firstFrame"
            ]
          }
        },
        "outputConstraints": {
          "durations": [
            2,
            3,
            4,
            5,
            6,
            7,
            8,
            9,
            10
          ],
          "defaultDuration": 5
        },
        "params": [
          {
            "key": "aspectRatio",
            "label": "画面比例",
            "labelKey": "plugins.parameter.aspectRatio",
            "type": "select",
            "options": [
              "16:9",
              "9:16"
            ],
            "default": "16:9",
            "numeric": false
          },
          {
            "key": "duration",
            "label": "时长",
            "labelKey": "plugins.parameter.duration",
            "type": "select",
            "options": [
              2,
              3,
              4,
              5,
              6,
              7,
              8,
              9,
              10
            ],
            "default": 5,
            "numeric": true
          }
        ],
        "requestTemplate": {
          "model": "{{model}}",
          "promptText": "{{prompt}}",
          "ratio": "{{params.aspectRatio}}",
          "duration": "{{params.duration}}",
          "promptImage": "{{imageUrl}}"
        },
        "isAsync": true,
        "taskIdPath": "id",
        "statusPath": "status",
        "resultUrlPath": "output.*",
        "taskEndpoint": {
          "path": "/v1/tasks/{taskId}",
          "method": "GET",
          "scope": "root"
        },
        "pollStatusMap": {
          "PENDING": "queued",
          "THROTTLED": "queued",
          "RUNNING": "running",
          "SUCCEEDED": "completed",
          "FAILED": "failed",
          "CANCELLED": "cancelled"
        },
        "progressPath": "progress",
        "progressScale": 100,
        "errorPath": "failure",
        "headers": {
          "X-Runway-Version": "2024-11-06"
        },
        "cancelEndpoint": {
          "path": "/v1/tasks/{taskId}",
          "method": "DELETE",
          "scope": "root"
        },
        "labelKey": "catalog.label.7a36e3422a",
        "inputMode": "firstFrame",
        "inputSlots": [
          "firstFrame"
        ],
        "requestValueMaps": {
          "aspectRatio": {
            "16:9": "1280:720",
            "9:16": "720:1280"
          }
        }
      }
    }
  ],
