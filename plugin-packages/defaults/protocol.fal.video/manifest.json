{
  "apiVersion": 1,
  "kind": "protocol",
  "id": "protocol.fal.video",
  "name": "fal.ai Queue Video",
  "version": "1.0.0",
  "shotloom": ">=0.9.1, <1.0.0",
  "category": "videoGeneration",
  "iconId": "fal",
  "engine": "declarative",
  "homepage": "https://fal.ai/models/fal-ai/veo3/fast/api",
  "protocols": [
    {
      "id": "generate",
      "mode": {
        "id": "text-to-video",
        "label": "文生视频",
        "endpoint": {
          "path": "/{modelPath}",
          "method": "POST",
          "scope": "root"
        },
        "auth": {
          "type": "header",
          "name": "Authorization",
          "prefix": "Key "
        },
        "inputConstraints": {},
        "outputConstraints": {
          "durations": [
            4,
            6,
            8
          ],
          "defaultDuration": 8
        },
        "params": [
          {
            "key": "aspectRatio",
            "label": "画面比例",
            "labelKey": "plugins.parameter.aspectRatio",
            "type": "select",
            "options": [
              "16:9",
              "9:16"
            ],
            "default": "16:9",
            "numeric": false
          },
          {
            "key": "duration",
            "label": "时长",
            "labelKey": "plugins.parameter.duration",
            "type": "select",
            "options": [
              4,
              6,
              8
            ],
            "default": 8,
            "numeric": true
          },
          {
            "key": "resolution",
            "label": "分辨率",
            "labelKey": "plugins.parameter.resolution",
            "type": "select",
            "options": [
              "720p",
              "1080p"
            ],
            "default": "720p",
            "numeric": false
          }
        ],
        "requestTemplate": {
          "prompt": "{{prompt}}",
          "aspect_ratio": "{{params.aspectRatio}}",
          "duration": "{{params.duration}}s",
          "resolution": "{{params.resolution}}"
        },
        "isAsync": true,
        "taskIdPath": "request_id",
        "statusPath": "status",
        "resultUrlPath": "video.url",
        "taskEndpoint": {
          "path": "/{modelOwner}/{modelName}/requests/{taskId}/status",
          "method": "GET",
          "scope": "root"
        },
        "pollStatusMap": {
          "IN_QUEUE": "queued",
          "IN_PROGRESS": "running",
          "COMPLETED": "completed",
          "FAILED": "failed",
          "CANCELLED": "cancelled"
        },
        "taskResultEndpoint": {
          "path": "/{modelOwner}/{modelName}/requests/{taskId}",
          "method": "GET",
          "scope": "root"
        },
        "cancelEndpoint": {
          "path": "/{modelOwner}/{modelName}/requests/{taskId}/cancel",
          "method": "PUT",
          "scope": "root"
        },
        "errorPath": "detail",
        "labelKey": "catalog.label.dd6f194c41"
      }
    }
  ],
  "providers": [],
  "author": "Shotloom Contributors",
  "defaultConnections": [
    {
      "id": "fal",
      "name": "fal.ai",
      "baseUrl": "https://queue.fal.run",
      "iconId": "fal",
      "description": "Queued image and video models on fal.ai",
      "descriptionKey": "plugins.provider.fal",
      "enabled": true,
      "builtin": true,
      "presetId": "protocol",
      "pluginId": "protocol.fal.video",
      "models": [
        {
          "id": "fal-veo3-fast",
          "name": "fal.ai · Veo 3 Fast",
          "upstreamModel": "fal-ai/veo3/fast",
          "type": "videoGeneration",
          "sortOrder": 100,
          "enabled": true,
          "defaultMode": "text-to-video",
          "protocolPlugin": "protocol.fal.video",
          "protocolModes": {
            "text-to-video": "generate"
          },
          "modes": [
            {
              "id": "text-to-video",
              "label": "文生视频",
              "inputConstraints": {},
              "outputConstraints": {
                "durations": [
                  4,
                  6,
                  8
                ]
              },
              "params": [
                {
                  "key": "aspectRatio",
                  "label": "画面比例",
                  "labelKey": "plugins.parameter.aspectRatio",
                  "type": "select",
                  "options": [
                    "16:9",
                    "9:16"
                  ],
                  "default": "16:9",
                  "numeric": false
                },
                {
                  "key": "duration",
                  "label": "时长",
                  "labelKey": "plugins.parameter.duration",
                  "type": "select",
                  "options": [
                    4,
                    6,
                    8
                  ],
                  "default": 8,
                  "numeric": true
                },
                {
                  "key": "resolution",
                  "label": "分辨率",
                  "labelKey": "plugins.parameter.resolution",
                  "type": "select",
                  "options": [
                    "720p",
                    "1080p"
                  ],
                  "default": "720p",
                  "numeric": false
                }
              ],
              "labelKey": "catalog.label.dd6f194c41"
            }
          ]
        }
      ],
      "preserveModelIds": true,
      "sortOrder": 16
    }
  ]
}
