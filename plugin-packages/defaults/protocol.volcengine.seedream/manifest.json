          "path": "/images/generations",
          "method": "POST",
          "scope": "root"
        },
        "auth": {
          "type": "bearer"
        },
        "inputConstraints": {
          "images": {
            "min": 1,
            "max": 10,
            "roles": [
              "referenceImage"
            ]
          }
        },
        "outputConstraints": {},
        "params": [
          {
            "key": "size",
            "label": "尺寸",
            "labelKey": "plugins.parameter.size",
            "type": "select",
            "options": [
              "2K",
              "4K"
            ],
            "default": "2K",
            "numeric": false
          }
        ],
        "requestTemplate": {
          "model": "{{model}}",
          "prompt": "{{prompt}}",
          "image": "{{imageUrls}}",
          "size": "{{params.size}}",
          "response_format": "url",
          "watermark": true
        },
        "resultUrlPath": "data.*.url",
        "labelKey": "catalog.label.a038dfa6cd",
        "inputMode": "reference",
        "inputSlots": [
          "reference"
        ]
      }
    }
