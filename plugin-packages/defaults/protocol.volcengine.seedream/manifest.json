          "method": "POST",
          "scope": "root"
        },
        "auth": {
          "type": "bearer"
        },
        "inputConstraints": {},
        "outputConstraints": {},
        "params": [
          {
            "key": "size",
            "label": "尺寸",
            "labelKey": "plugins.parameter.size",
            "type": "select",
            "options": [
              "2K",
              "4K"
            ],
            "default": "2K",
            "numeric": false
          }
        ],
        "requestTemplate": {
          "model": "{{model}}",
          "prompt": "{{prompt}}",
          "size": "{{params.size}}",
          "response_format": "url",
          "watermark": true
        },
        "resultUrlPath": "data.*.url",
        "labelKey": "catalog.label.0b835958b8"
      }
    },
    {
      "id": "edit",
      "mode": {
