{
  "apiVersion": 1,
  "kind": "protocol",
  "id": "protocol.minimax.images",
  "name": "MiniMax H3 Images",
  "version": "1.0.0",
  "shotloom": ">=0.9.1, <1.0.0",
  "category": "imageGeneration",
  "iconId": "minimax",
  "engine": "declarative",
  "homepage": "https://platform.minimax.io/docs/guides/image-generation",
  "protocols": [
    {
      "id": "generate",
      "mode": {
        "id": "text-to-image",
        "label": "文生图",
        "endpoint": {
          "path": "/v1/images/generations",
          "method": "POST",
          "scope": "root"
        },
        "auth": {
          "type": "bearer"
        },
        "inputConstraints": {},
        "outputConstraints": {
          "maxCount": 4,
          "formats": [
            "jpeg",
            "png",
            "webp"
          ]
        },
        "params": [
          {
            "key": "aspectRatio",
            "label": "画面比例",
            "labelKey": "plugins.parameter.aspectRatio",
            "type": "select",
            "options": [
              "1:1",
              "16:9",
              "9:16",
              "4:3",
              "3:4"
            ],
            "default": "1:1",
            "numeric": false
          },
          {
            "key": "count",
            "label": "数量",
            "labelKey": "plugins.parameter.generationCount",
            "type": "select",
            "options": [
              1,
              2,
              3,
              4
            ],
            "default": 1,
            "numeric": true
          }
        ],
        "requestTemplate": {
          "model": "{{model}}",
          "prompt": "{{prompt}}",
          "aspect_ratio": "{{params.aspectRatio}}",
          "n": "{{params.count}}",
          "response_format": "url"
        },
        "resultUrlPath": "data.*.url",
        "labelKey": "catalog.label.0b835958b8",
        "resultFormatPath": "output_format"
      }
    },
    {
      "id": "edit",
      "mode": {
        "id": "image-to-image",
        "label": "图片编辑",
        "endpoint": {
          "path": "/v1/images/edits",
          "method": "POST",
          "scope": "root"
        },
        "auth": {
          "type": "bearer"
        },
        "inputConstraints": {
          "images": {
            "min": 1,
            "max": 16,
            "roles": [
              "referenceImage"
            ]
          }
        },
        "outputConstraints": {
          "maxCount": 4,
          "formats": [
            "jpeg",
            "png",
            "webp"
          ]
        },
        "params": [
          {
            "key": "aspectRatio",
            "label": "画面比例",
            "labelKey": "plugins.parameter.aspectRatio",
            "type": "select",
            "options": [
              "1:1",
              "16:9",
              "9:16",
              "4:3",
              "3:4"
            ],
            "default": "1:1",
            "numeric": false
          },
          {
            "key": "count",
            "label": "数量",
            "labelKey": "plugins.parameter.generationCount",
            "type": "select",
            "options": [
              1,
              2,
              3,
              4
            ],
            "default": 1,
            "numeric": true
          }
        ],
        "requestTemplate": {
          "model": "{{model}}",
          "prompt": "{{prompt}}",
          "aspect_ratio": "{{params.aspectRatio}}",
          "n": "{{params.count}}",
          "response_format": "url",
          "images": "{{content}}"
        },
        "resultUrlPath": "data.*.url",
        "labelKey": "catalog.label.a038dfa6cd",
        "resultFormatPath": "output_format",
        "inputMode": "reference",
        "inputSlots": [
          "reference"
        ],
        "contentTemplate": {
          "image": {
            "image_url": "{{url}}"
          }
        }
      }
    }
  ],
  "providers": [],
  "author": "Shotloom Contributors",
