  "engine": "declarative",
  "protocols": [
    {
      "id": "operation.2ebb0f9f0434abd5",
      "description": "Gemini 3.8 Flash",
      "mode": {
        "endpoint": {
          "method": "POST",
          "path": "/openai/chat/completions",
          "scope": "root"
        },
        "requestFields": {
          "imageContentFormat": "openai-image-url"
        },
        "agent": {
          "transport": "provider-default",
          "supportsTools": true
        },
        "auth": {
          "type": "bearer"
        },
        "requestTemplate": {
          "model": "{{model}}",
          "messages": "{{messages}}",
          "max_tokens": "{{params.maxTokens}}",
          "tools": "{{tools}}",
          "tool_choice": "{{toolChoice}}",
          "reasoning_effort": "{{params.reasoningEffort}}"
        },
        "resultTextPath": "choices.0.message.content",
        "id": "text-generation",
        "label": "文本生成",
        "inputConstraints": {
          "text": {
            "maxTokens": 1000000
          },
          "images": {
            "max": 1,
            "roles": [
              "referenceImage"
            ]
          }
        },
        "outputConstraints": {
          "supportsStreaming": true,
          "supportsStructuredOutput": true,
          "maxTokens": 16384
        },
        "capabilities": [
          "reasoning"
        ],
        "params": [
          {
            "key": "maxTokens",
            "label": "最大长度",
            "type": "select",
            "default": 8192,
            "numeric": true,
            "options": [
              4096,
              8192,
              16384
            ],
            "labelKey": "catalog.label.c6f7a87b1e"
          },
          {
            "key": "reasoningEffort",
            "label": "推理强度",
            "type": "select",
            "default": "medium",
            "options": [
              "minimal",
              "low",
              "medium",
              "high"
            ],
            "optionLabels": {
              "minimal": "极简",
              "low": "低",
              "medium": "中",
              "high": "高"
            },
            "labelKey": "catalog.label.66778fdee4",
            "optionLabelKeys": {
              "minimal": "catalog.label.4d9492c5f8",
              "low": "catalog.label.b9ee259b7f",
              "medium": "catalog.label.0869071c92",
              "high": "catalog.label.b096b3f5ac"
            }
          }
        ],
        "labelKey": "catalog.label.9612898b53"
      }
    },
