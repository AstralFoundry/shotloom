{
  "apiVersion": 1,
  "kind": "protocol",
  "id": "protocol.qwen.images",
  "name": "阿里云百炼 Qwen / Wan Images",
  "version": "1.0.0",
  "shotloom": ">=0.9.1, <1.0.0",
  "category": "imageGeneration",
  "iconId": "qwen",
  "engine": "declarative",
  "protocols": [
    {
      "id": "operation.f67cb0f77e3df802",
      "description": "Qwen Image 3.0 Pro",
      "mode": {
        "endpoint": {
          "method": "POST",
          "path": "/api/v1/services/aigc/multimodal-generation/generation",
          "scope": "root"
        },
        "auth": {
          "type": "bearer"
        },
        "requestTemplate": {
          "model": "{{model}}",
          "input": {
            "messages": [
              {
                "role": "user",
                "content": [
                  {
                    "text": "{{prompt}}"
                  }
                ]
              }
            ]
          },
          "parameters": {
            "size": "{{params.size}}",
            "n": "{{params.generationCount}}",
            "prompt_extend": true,
            "watermark": false
          }
        },
        "resultUrlPath": "output.choices.*.message.content.*.image",
        "id": "text-to-image",
        "label": "文生图",
        "inputConstraints": {
          "images": {
            "min": 0,
            "max": 0
          }
        },
        "outputConstraints": {
          "maxCount": 6,
          "formats": [
            "png",
            "jpg"
          ]
        },
        "params": [
          {
            "key": "prompt",
            "label": "提示词",
            "type": "text",
            "required": true,
            "labelKey": "catalog.label.2f0bb12387"
          },
          {
            "key": "size",
            "label": "尺寸",
            "type": "select",
            "default": "2048*2048",
            "options": [
              "2048*2048",
              "2304*1728",
              "1728*2304"
            ],
            "optionLabels": {
              "2048*2048": "1:1",
              "2304*1728": "4:3",
              "1728*2304": "3:4"
            },
            "labelKey": "catalog.label.94a6711f24",
            "optionLabelKeys": {}
          },
          {
            "key": "generationCount",
            "label": "张数",
            "type": "select",
            "default": 1,
            "numeric": true,
            "options": [
              1,
              2,
              4,
              6
            ],
            "labelKey": "catalog.label.33abb92abd"
          }
        ],
        "labelKey": "catalog.label.0b835958b8"
      }
    }
  ],
  "providers": [],
  "author": "Shotloom Contributors",
